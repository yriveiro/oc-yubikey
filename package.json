{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "oc-yubikey",
  "version": "0.1.0",
  "description": "OpenCode V2 plugin for macOS gpg-agent + YubiKey OpenPGP PIN entry via TUI modal and RPC",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui.tsx",
    "./rpc": "./src/rpc.ts"
  },
  "bin": {
    "oc-yubikey": "./bin/oc-yubikey"
  },
  "files": [
    "index.ts",
    "tui.tsx",
    "rpc.ts",
    "bin",
    "src",
    "tsconfig.json",
    "README.md"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.0",
    "@opencode/theme": ">=2.0.0",
    "@opentui/core": ">=0.5.17",
    "@opentui/solid": ">=0.5.17",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opencode/theme": {
      "optional": true
    }
  }
}
