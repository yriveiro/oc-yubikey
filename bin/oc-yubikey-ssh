#!/bin/sh
export PATH="/opt/homebrew/bin:/usr/local/MacGPG2/bin:/usr/local/bin:/usr/bin:/bin"
SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
export OC_YUBIKEY_MODE="ssh"
for RUNTIME_BIN in \
  /opt/homebrew/bin/bun \
  /usr/local/bin/bun \
  "$HOME/.bun/bin/bun" \
  /opt/homebrew/bin/node \
  /usr/local/bin/node \
  /usr/bin/node
do
  if [ -n "$RUNTIME_BIN" ] && [ -x "$RUNTIME_BIN" ] && [ -f "$RUNTIME_BIN" ]; then
    exec "$RUNTIME_BIN" "$SCRIPT_DIR/../src/cli.ts" "$@"
  fi
done
echo "oc-yubikey-ssh: neither bun nor node found in trusted paths" >&2
exit 1
